{
  "manifest_version": 3,
  "name": "One-Click Email Automation",
  "version": "0.1.0",
  "description": "Prepare repetitive email outreach in seconds from any email address on a webpage.",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "One-Click Email Automation"
  }
}
